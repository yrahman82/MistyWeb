# MistyVPN — London (uk-1) — OpenVPN TCP
# Enter your MistyVPN VPN username/password when prompted (Account → VPN Credentials in the app).
# For a router, replace 'auth-user-pass' with 'auth-user-pass creds.txt' (2 lines: username, then password).
client
dev tun
proto tcp
remote gb-lon-1.mistyvpn.com 10007
resolv-retry infinite
nobind
persist-key
persist-tun
cipher AES-256-GCM
data-ciphers AES-256-GCM
auth SHA256
tls-version-min 1.2
reneg-sec 120
auth-user-pass
verb 3
<ca>
